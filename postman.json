{
  "info": {
    "name": "Paperless API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.3.0",
    "description": "Run the complete collection in order. Creates uniquely named test data and deletes its document records/tags at the end. Set Postman's working directory to the repository root or select _docs/postman/sample.pdf manually. Newman: newman run postman.json --working-dir . . The backend currently leaves uploaded files in storage after DELETE. Do not manually set the multipart Content-Type header; the client supplies its boundary."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "documentTitle",
      "value": "Invoice 2026"
    },
    {
      "key": "updatedTitle",
      "value": "Updated Invoice"
    },
    {
      "key": "tagName",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "untaggedDocumentId",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "item": [
    {
      "name": "Configuration",
      "item": [
        {
          "name": "Get Validation Rules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/config/validation"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Validation rules\", () => { const r=pm.response.json(); pm.expect(r.maxTitleLength).to.be.above(0); pm.expect(r.maxFileSize).to.be.above(0); pm.expect(r.allowedContentTypes).to.include(\"application/pdf\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Create Tag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tags",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{tagName}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"tagName\", \"API-test-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"tagId\", \"documentId\", \"untaggedDocumentId\"].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"tagId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tags"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document With Tag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\": \"{{documentTitle}}\", \"tagId\": \"{{tagId}}\"}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "_docs/postman/sample.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"documentId\", pm.response.json().id);",
                  "pm.test(\"Upload metadata comes from file\", () => { const d = pm.response.json(); pm.expect(d.originalFilename).to.eql(\"sample.pdf\"); pm.expect(d.contentType).to.eql(\"application/pdf\"); pm.expect(d.fileSize).to.be.above(0); pm.expect(d.tagId).to.eql(pm.collectionVariables.get(\"tagId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Document Without Tag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\": \"{{documentTitle}}\"}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "_docs/postman/sample.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"untaggedDocumentId\", pm.response.json().id);",
                  "pm.test(\"No tag\", () => pm.expect(pm.response.json().tagId).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Uploaded document exists\", () => pm.expect(pm.response.json().some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Document details\", () => { const d=pm.response.json(); pm.expect(d.id).to.eql(pm.collectionVariables.get(\"documentId\")); [\"title\",\"originalFilename\",\"contentType\",\"fileSize\",\"createdAt\",\"updatedAt\"].forEach(k => pm.expect(d).to.have.property(k)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Document Title",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"{{updatedTitle}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updated title\", () => pm.expect(pm.response.json().title).to.eql(pm.collectionVariables.get(\"updatedTitle\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Document After Title Update",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Title persisted\", () => pm.expect(pm.response.json().title).to.eql(pm.collectionVariables.get(\"updatedTitle\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Blank Title",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"   \"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Title field error\", () => pm.expect(pm.response.json().details).to.have.property(\"title\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Long Title",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"xxxxxxxxxxxxxxxxxxxxx\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Update Of Missing Document",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{missingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Valid title\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Invalid Document UUID",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/not-a-uuid",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Valid title\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Title Unchanged After Invalid Updates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Valid title retained\", () => pm.expect(pm.response.json().title).to.eql(pm.collectionVariables.get(\"updatedTitle\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter By Tag",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents?tag={{tagName}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Matching documents only\", () => { const rows=pm.response.json(); pm.expect(rows.some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(true); rows.forEach(d => pm.expect(d.tagName).to.eql(pm.collectionVariables.get(\"tagName\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove Document Tag",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/tag",
            "body": {
              "mode": "raw",
              "raw": "{\"tagId\": null}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tag removed\", () => pm.expect(pm.response.json().tagId).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter Untagged Documents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents?tag=none"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Untagged documents only\", () => { const rows=pm.response.json(); pm.expect(rows.some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(true); rows.forEach(d => pm.expect(d.tagId).to.eql(null)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Assign Document Tag",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/tag",
            "body": {
              "mode": "raw",
              "raw": "{\"tagId\": \"{{tagId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
