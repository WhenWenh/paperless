{
  "info": {
    "name": "Paperless API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.3.0",
    "description": "Run Authentication first, then the CRUD/OCR requests and Cleanup. Authentication obtains a fresh token from the development Keycloak test user. Working directory: _postman. Docker: bash tests-newman.sh. For OCR only: bash tests-newman.sh --folder Authentication --folder \"OCR Testing\". See README.md in _postman. Multipart boundaries are generated automatically. HTTP assertions do not verify RabbitMQ queue contents."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "documentTitle",
      "value": "Invoice 2026"
    },
    {
      "key": "updatedTitle",
      "value": "Updated Invoice"
    },
    {
      "key": "tagName",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "untaggedDocumentId",
      "value": ""
    },
    {
      "key": "missingId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Valid Keycloak access token without Bearer prefix. Set locally; do not commit credentials."
    },
    {
      "key": "ocrPdfDocumentId",
      "value": "",
      "type": "string",
      "description": "Set by the valid PDF OCR test."
    },
    {
      "key": "ocrPngDocumentId",
      "value": "",
      "type": "string",
      "description": "Set by the valid PNG OCR test."
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:9445"
    },
    {
      "key": "clientId",
      "value": "paperless-postman"
    },
    {
      "key": "clientSecret",
      "value": "paperless-postman-secret"
    },
    {
      "key": "username",
      "value": "test"
    },
    {
      "key": "password",
      "value": "test"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"accessToken\");",
                  "pm.environment.unset(\"accessToken\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
                  "let body = {}; try { body = pm.response.json(); } catch (_) {}",
                  "pm.test(\"Access token received\", () => pm.expect(body.access_token).to.be.a(\"string\").and.not.empty);",
                  "if (pm.response.code === 200 && body.access_token) {",
                  "  pm.collectionVariables.set(\"accessToken\", body.access_token);",
                  "} else {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error(\"Keycloak login failed. Check test user and client credentials.\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/paperless/protocol/openid-connect/token",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Configuration",
      "item": [
        {
          "name": "Get Validation Rules",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/config/validation"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Validation rules\", () => { const r=pm.response.json(); pm.expect(r.maxTitleLength).to.be.above(0); pm.expect(r.maxFileSize).to.be.above(0); pm.expect(r.allowedContentTypes).to.include(\"application/pdf\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "Create Tag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tags",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"{{tagName}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"tagName\", \"API-test-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"tagId\", \"documentId\", \"untaggedDocumentId\"].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"tagId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tags"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document With Tag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\": \"{{documentTitle}}\", \"tagId\": \"{{tagId}}\"}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"documentId\", pm.response.json().id);",
                  "pm.test(\"Upload metadata comes from file\", () => { const d = pm.response.json(); pm.expect(d.originalFilename).to.eql(\"sample.pdf\"); pm.expect(d.contentType).to.eql(\"application/pdf\"); pm.expect(d.fileSize).to.be.above(0); pm.expect(d.tagId).to.eql(pm.collectionVariables.get(\"tagId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload Document Without Tag",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\": \"{{documentTitle}}\"}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"untaggedDocumentId\", pm.response.json().id);",
                  "pm.test(\"No tag\", () => pm.expect(pm.response.json().tagId).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Uploaded document exists\", () => pm.expect(pm.response.json().some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Document details\", () => { const d=pm.response.json(); pm.expect(d.id).to.eql(pm.collectionVariables.get(\"documentId\")); [\"title\",\"originalFilename\",\"contentType\",\"fileSize\",\"createdAt\",\"updatedAt\"].forEach(k => pm.expect(d).to.have.property(k)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Document Title",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"{{updatedTitle}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Updated title\", () => pm.expect(pm.response.json().title).to.eql(pm.collectionVariables.get(\"updatedTitle\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Document After Title Update",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Title persisted\", () => pm.expect(pm.response.json().title).to.eql(pm.collectionVariables.get(\"updatedTitle\")));"
                ]
              }
            }
          ]
        },
