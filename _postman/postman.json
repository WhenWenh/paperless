            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents?tag=none"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Untagged documents only\", () => { const rows=pm.response.json(); pm.expect(rows.some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(true); rows.forEach(d => pm.expect(d.tagId).to.eql(null)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Assign Document Tag",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/tag",
            "body": {
              "mode": "raw",
              "raw": "{\"tagId\": \"{{tagId}}\"}",
