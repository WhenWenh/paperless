                  "pm.test(\"Valid title retained\", () => pm.expect(pm.response.json().title).to.eql(pm.collectionVariables.get(\"updatedTitle\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter By Tag",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents?tag={{tagName}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Matching documents only\", () => { const rows=pm.response.json(); pm.expect(rows.some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(true); rows.forEach(d => pm.expect(d.tagName).to.eql(pm.collectionVariables.get(\"tagName\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove Document Tag",
