    {
      "name": "OCR Testing",
      "description": "US-17: six independent upload requests with automatic HTTP assertions. Set collection/environment variable accessToken to a valid Keycloak access token (without Bearer prefix). Set Postman working directory to the _postman directory. File bodies use sample.pdf, ocr-sample.png and ocr-empty.pdf; select these manually if Postman does not resolve the relative paths. Run in order. For queue verification stop OCR first and ensure consumers=0; record messages_ready before and after each request. Only the valid PDF increases it by 1. These tests do not call the RabbitMQ management API. Restart OCR after the queue check. The full collection Cleanup folder deletes the two created document IDs; running only this folder leaves those documents available for inspection.",
      "item": [
        {
          "name": "01 - Valid PDF - 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "description": "US-17. Expected HTTP 201. Manual RabbitMQ check: messages_ready delta +1 with OCR stopped, no other consumers and no parallel uploads. Queue behavior is NOT asserted by these HTTP tests. This creates a real document; its ID is saved in ocrPdfDocumentId. The Cleanup folder deletes it during a full collection run.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\":\"OCR PDF Test\",\"tagId\":null}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"ocrPdfDocumentId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const document = pm.response.json();",
                  "  pm.test(\"Document ID is a UUID\", () => pm.expect(document.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "  pm.test(\"Uploaded MIME type\", () => pm.expect(document.contentType).to.eql(\"application/pdf\"));",
                  "  pm.test(\"Uploaded title\", () => pm.expect(document.title).to.eql(\"OCR PDF Test\"));",
                  "  pm.test(\"Non-empty stored file\", () => pm.expect(document.fileSize).to.be.above(0));",
                  "  if (typeof document.id === \"string\") pm.collectionVariables.set(\"ocrPdfDocumentId\", document.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Allowed PNG - 201",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "description": "US-17. Expected HTTP 201. Manual RabbitMQ check: messages_ready delta 0 with OCR stopped, no other consumers and no parallel uploads. Queue behavior is NOT asserted by these HTTP tests. This creates a real document; its ID is saved in ocrPngDocumentId. The Cleanup folder deletes it during a full collection run.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\":\"OCR PNG Test\",\"tagId\":null}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "ocr-sample.png",
                  "contentType": "image/png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"ocrPngDocumentId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const document = pm.response.json();",
                  "  pm.test(\"Document ID is a UUID\", () => pm.expect(document.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "  pm.test(\"Uploaded MIME type\", () => pm.expect(document.contentType).to.eql(\"image/png\"));",
                  "  pm.test(\"Uploaded title\", () => pm.expect(document.title).to.eql(\"OCR PNG Test\"));",
                  "  pm.test(\"Non-empty stored file\", () => pm.expect(document.fileSize).to.be.above(0));",
                  "  if (typeof document.id === \"string\") pm.collectionVariables.set(\"ocrPngDocumentId\", document.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Metadata Without File - 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "description": "US-17. Expected HTTP 400. Manual RabbitMQ check: messages_ready delta 0 with OCR stopped, no other consumers and no parallel uploads. Queue behavior is NOT asserted by these HTTP tests. Intentionally invalid request; no OCR job should be created.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\":\"OCR Metadata Test\",\"tagId\":null}",
                  "contentType": "application/json"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - JSON Only - 415",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "description": "US-17. Expected HTTP 415. Manual RabbitMQ check: messages_ready delta 0 with OCR stopped, no other consumers and no parallel uploads. Queue behavior is NOT asserted by these HTTP tests. Intentionally invalid request; no OCR job should be created.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"OCR JSON Test\",\n  \"tagId\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 415\", () => pm.response.to.have.status(415));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Empty File - 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "description": "US-17. Expected HTTP 400. Manual RabbitMQ check: messages_ready delta 0 with OCR stopped, no other consumers and no parallel uploads. Queue behavior is NOT asserted by these HTTP tests. Intentionally invalid request; no OCR job should be created.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\":\"OCR Empty Test\",\"tagId\":null}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "ocr-empty.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Invalid Title - 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/documents",
            "description": "US-17. Expected HTTP 400. Manual RabbitMQ check: messages_ready delta 0 with OCR stopped, no other consumers and no parallel uploads. Queue behavior is NOT asserted by these HTTP tests. Intentionally invalid request; no OCR job should be created.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\":\"\",\"tagId\":null}",
                  "contentType": "application/json"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample.pdf",
                  "contentType": "application/pdf"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"Empty response\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Deleted Document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deleted Document Absent From List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Document removed\", () => pm.expect(pm.response.json().some(d => d.id === pm.collectionVariables.get(\"documentId\"))).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Document Again",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Untagged Test Document",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/documents/{{untaggedDocumentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Tag",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/tags/{{tagId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete OCR PDF Test Document",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/documents/{{ocrPdfDocumentId}}",
            "description": "Deletes only the document ID captured by the corresponding successful OCR test. Skipped if that upload did not produce an ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"ocrPdfDocumentId\")) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cleanup returns 204 or already absent 404\", () => pm.expect(pm.response.code).to.be.oneOf([204, 404]));",
                  "if ([204, 404].includes(pm.response.code)) pm.collectionVariables.unset(\"ocrPdfDocumentId\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete OCR PNG Test Document",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/documents/{{ocrPngDocumentId}}",
            "description": "Deletes only the document ID captured by the corresponding successful OCR test. Skipped if that upload did not produce an ID."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"ocrPngDocumentId\")) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cleanup returns 204 or already absent 404\", () => pm.expect(pm.response.code).to.be.oneOf([204, 404]));",
                  "if ([204, 404].includes(pm.response.code)) pm.collectionVariables.unset(\"ocrPngDocumentId\");"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
