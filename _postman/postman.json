            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Title field error\", () => pm.expect(pm.response.json().details).to.have.property(\"title\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Long Title",
